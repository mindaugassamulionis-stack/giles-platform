# UAB „Gilės inžinerija“ (EGIP.lt) — Plug-and-Play Integracijų ir API Raktų Šablonas (.env.example)
# Visos 14 mokėjimų, kurjerių, buhalterijos, el. pašto/SMS ir AI integracijų yra sujungtos kode.
# Įveskite API raktus čia arba tiesiogiai /lt/admin -> „Integracijos ir API Raktai (14)“ valdymo centre.

# ==============================================================================
# 1. MOKĖJIMŲ SISTEMOS (PAYMENT GATEWAYS)
# ==============================================================================

# 1.1 Montonio — Lietuvos Banklinkai (Swedbank, SEB, Luminor, Revolut, Citadele) + Kortelės
# Webhook URL: /api/integrations/webhooks/montonio
MONTONIO_ACCESS_KEY=""
MONTONIO_SECRET_KEY=""
MONTONIO_ENV="sandbox"

# 1.2 Paysera Checkout — Banklinkai, Kortelės ir Mokėjimų inicijavimas
# Webhook URL: /api/integrations/webhooks/paysera
PAYSERA_PROJECT_ID=""
PAYSERA_SIGN_PASSWORD=""
PAYSERA_ENV="sandbox"

# 1.3 Stripe — Visa / Mastercard, Apple Pay, Google Pay, SEPA
# Webhook URL: /api/integrations/webhooks/stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# 1.4 Išankstinė PVM sąskaita faktūra / Bankinis pavedimas + SEPA camt.053 (AKTYVUOTA IŠ KARTO)
GILES_IBAN="LT627300010128945112"
GILES_BANK_NAME="Swedbank, AB"
GILES_PAYMENT_TERM_DAYS="14"

# ==============================================================================
# 2. KURJERIAI, PALETĖS IR PAŠTOMATAI (SHIPPING & LOGISTICS)
# ==============================================================================

# 2.1 Venipak — Sunkių katilų / palečių (50–800 kg) kurjeris ir paštomatai
# Webhook URL: /api/integrations/webhooks/venipak
VENIPAK_API_ID=""
VENIPAK_API_USER=""
VENIPAK_API_PASSWORD=""
VENIPAK_WAREHOUSE_ADDRESS="Savanorių pr. 191A, LT-50182 Kaunas"

# 2.2 DPD Lietuva — Kurjeris, paletės ir Pickup paštomatai
# Webhook URL: /api/integrations/webhooks/dpd
DPD_API_TOKEN=""
DPD_CLIENT_ID=""
DPD_SENDER_ZIP="50182"

# 2.3 Omniva LT — Paštomatų tinklas smulkioms dalims, vožtuvams ir automatikai
# Webhook URL: /api/integrations/webhooks/omniva
OMNIVA_API_USER=""
OMNIVA_API_PASSWORD=""
OMNIVA_RETURN_CODE=""

# 2.4 LP Express / Lietuvos paštas — Paštomatai ir kurjeris
LPEXPRESS_API_USER=""
LPEXPRESS_API_PASSWORD=""

# ==============================================================================
# 3. BUHALTERIJA, VMI IR VALSTYBĖS REGISTRAI (ACCOUNTING & ERP)
# ==============================================================================

# 3.1 UAB Prototechnika „Skaita“ — Buhalterinė apskaita ir sandėlis (AKTYVUOTA CSV/EIP + SQL TILTAS)
SKAITA_ODBC_DSN=""
SKAITA_SQL_HOST=""
SKAITA_SQL_USER=""
SKAITA_SQL_PASSWORD=""
SKAITA_DEFAULT_WAREHOUSE="KAUNAS_SAVANORIU_191A"

# 3.2 VMI i.MAS — i.SAF 1.2 PVM sąskaitų registras ir i.VAZ važtaraščiai (AKTYVUOTA XML + API)
VMI_IMAS_API_TOKEN=""
VMI_TAXPAYER_CODE="302620907"

# 3.3 Registrų Centras / ES VIES — Įmonės kodo ir PVM mokėtojo automatinė patikra (AKTYVUOTA)
VIES_SOAP_ENABLED="true"
RC_API_KEY=""

# ==============================================================================
# 4. EL. PAŠTAS, SMS IR PRANEŠIMAI (COMMUNICATIONS)
# ==============================================================================

# 4.1 El. pašto serveris (bumslangis.serveriai.lt) — Sąskaitų ir užsakymų siuntimas
SMTP_HOST="bumslangis.serveriai.lt"
SMTP_PORT="465"
SMTP_USER="info@gilesinzinerija.lt"
SMTP_PASSWORD=""

# 4.2 SMS Biuras — SMS pranešimai klientams ir serviso meistrų iškvietimams
SMS_BIURAS_API_KEY=""
SMS_SENDER_ID="GilesInz"

# ==============================================================================
# 5. AI INŽINIERIUS, REKLAMOS SRAUTAS IR ANALITIKA (AI & GROWTH)
# ==============================================================================

# 5.1 xAI Grok (Vytautas 2.0 AI) + GA4 + Meta CAPI + Google Merchant XML Feed (AKTYVUOTA)
XAI_DIRECT_API_KEY=""
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_TOKEN=""

# ==============================================================================
# 6. PARDUOTUVĖS TAPATYBĖ (STORE IDENTITY) — privaloma
# ==============================================================================
# Gilės Inžinerija — vienintelė šio diegimo parduotuvė. Be STORE_SLUG (arba
# STORE_ID) serveris neįsijungia (fail-closed, WP-W119-A2); jokio kito
# duombazės įrašo atsarginis variantas nenaudojamas.
STORE_SLUG="giles-inzinierija"
# NEXT_PUBLIC_STORE_ID nebenaudojamas — kliento tapatybę SSR įšvirkščia
# __STORE_IDENTITY__ JSON (src/app/[locale]/layout.tsx).
